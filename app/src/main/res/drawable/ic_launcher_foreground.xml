<?xml version="1.0" encoding="utf-8"?>
<!--
  Ikon adaptif Ketemu.
  Bentuknya sederhana: kaca pembesar (simbol "mencari") dengan gagang di palet Teal.
  Seluruh gambar berada di dalam "safe zone" 72dp dari 108dp, sehingga tetap utuh
  ketika peluncur ponsel memotongnya menjadi bulat, kotak membulat, atau persegi.
  Warna latar diambil dari res/values/ic_launcher_background.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lensa kaca pembesar -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:pathData="M48,42 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0" />

    <!-- Gagang kaca pembesar -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M59,53 L72,66" />

    <!-- Titik aksen Orange, penanda "barang ditemukan" -->
    <path
        android:fillColor="#F89830"
        android:pathData="M48,42 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
